rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/multiplayerClock/{sampleId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['time'])
        && request.resource.data.time == request.time;
    }
    match /users/{userId}/progress/{document} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && document == 'state'
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 500000
        && request.resource.data.updatedAt is int;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      // Initial registration: default base stats (elo 1200, 0 wins/losses)
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.elo == 1200
        && request.resource.data.wins == 0
        && request.resource.data.losses == 0
        && request.resource.data.draws == 0
        && request.resource.data.matchesPlayed == 0
        && request.resource.data.uid == userId;

      // Update: must be verified against a finished match in lobbies, or cosmetic profile update
      allow update: if request.auth != null && (
        (request.auth.uid == userId && isSelfProfileUpdate()) ||
        isValidMatchLeaderboardUpdate(userId)
      );
    }

    function isSelfProfileUpdate() {
      return request.resource.data.elo == resource.data.elo
        && request.resource.data.wins == resource.data.wins
        && request.resource.data.losses == resource.data.losses
        && request.resource.data.draws == resource.data.draws
        && request.resource.data.matchesPlayed == resource.data.matchesPlayed;
    }

    function isValidMatchLeaderboardUpdate(userId) {
      let matchId = request.resource.data.lastMatchId;
      let matchData = getAfter(/databases/$(database)/documents/lobbies/$(matchId)).data;
      let isHost = matchData.host.uid == userId;
      let isGuest = matchData.get('guest', null) != null && matchData.guest.uid == userId;
      let isPlayerInMap = matchData.get('players', null) != null && userId in matchData.players;

      let callerIsParticipant = request.auth.uid == userId ||
        (matchData.get('players', null) != null && request.auth.uid in matchData.players) ||
        (matchData.get('guest', null) != null && request.auth.uid == matchData.guest.uid) ||
        matchData.host.uid == request.auth.uid;

      let isFinished = matchData.status == 'finished';
      let eloDiff = matchData.game.eloChanges[userId];
      let expectedElo = (resource.data.elo + eloDiff < 100) ? 100 : resource.data.elo + eloDiff;
      let freshMatch = resource.data.get('lastMatchId', '') != matchId;

      return callerIsParticipant
        && (isHost || isGuest || isPlayerInMap)
        && isFinished
        && request.resource.data.elo == expectedElo
        && request.resource.data.matchesPlayed == resource.data.matchesPlayed + 1
        && freshMatch;
    }

    match /lobbies/{lobbyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host.uid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.get('playerCount', 1) <= 10;

      allow update: if request.auth != null && (
        // Host can update their lobby
        request.auth.uid == resource.data.host.uid ||
        // Guest can update if already in the lobby
        (resource.data.get('guest', null) != null && request.auth.uid == resource.data.guest.uid) ||
        // Player in players map can update
        (resource.data.get('players', null) != null && request.auth.uid in resource.data.players) ||
        // A new user can join as guest if slot is open
        (resource.data.get('guest', null) == null && request.resource.data.get('guest', null) != null
          && request.resource.data.guest.uid == request.auth.uid
          && request.resource.data.host.uid == resource.data.host.uid) ||
        // A new user can join the players map if under capacity (up to 10 players)
        (resource.data.status == 'waiting'
          && request.resource.data.get('playerCount', 0) <= 10
          && resource.data.get('playerCount', 0) < 10
          && request.auth.uid in request.resource.data.players
          && (!(resource.data.get('players', null) != null) || !(request.auth.uid in resource.data.players))
          && request.resource.data.host.uid == resource.data.host.uid)
      );

      allow delete: if request.auth != null
        && resource.data.host.uid == request.auth.uid;

      match /presence/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'sessionId', 'seenAt'])
          && request.resource.data.uid == userId
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() > 0
          && request.resource.data.sessionId.size() <= 128
          && request.resource.data.seenAt == request.time
          && presenceAllowed();

        function presenceAllowed() {
          let lobby = get(/databases/$(database)/documents/lobbies/$(lobbyId)).data;
          return userId in lobby.players && (
            lobby.status == 'waiting' || (
              lobby.status != 'finished'
              && !(userId in lobby.game.get('forfeitedUids', []))
              && request.time < resource.data.seenAt + duration.value(45, 's')
            )
          );
        }
      }

      match /answers/{answerId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
      }
    }
  }
}
