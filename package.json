{
  "name": "tentaplugg-japanska",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:rules": "node --test --test-isolation=none tests/emulator/*.test.js",
    "test:emulators": "firebase emulators:exec --only auth,firestore --project demo-tentaplugg \"npm run test:rules\"",
    "test:ci": "firebase emulators:exec --only auth,firestore --project demo-tentaplugg \"npm run test:rules && npm run test:e2e\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lit-html": "^3.3.3",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.9",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
